// Northstar — the operating system for your career.
// Prisma schema for the MVP data model.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RiskTolerance {
  LOW
  MEDIUM
  HIGH
}

enum ConnectorType {
  LINKEDIN
  GMAIL
  CALENDAR
  JOB_BOARDS
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile    Profile?
  connectors Connector[]
}

model Profile {
  id              String        @id @default(cuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentEmployer String?
  currentTitle    String?
  currentSalary   Int?
  currency        String        @default("DKK")
  commuteMinutes  Int?
  industry        String?
  location        String?
  skills          String[]      @default([])
  yearsExperience Int?
  familySituation String?
  careerGoals     String?
  riskTolerance   RiskTolerance @default(MEDIUM)
  cvText          String?
  cvUpdatedAt     DateTime?
  currentPromotionOutlook Int?
  currentLearningRating   Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Connector {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ConnectorType
  connected   Boolean       @default(false)
  connectedAt DateTime?
  syncedData  Json?

  @@unique([userId, type])
}
